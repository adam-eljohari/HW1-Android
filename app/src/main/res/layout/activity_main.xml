<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background"
    tools:context="MainActivity">




    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/main_FAB_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/default_margin"
        android:clickable="true"
        android:text="@string/left"
        android:textAllCaps="true"
        android:textStyle="bold"
        app:icon="@drawable/arrow_left"
        app:iconTint="@color/white" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/main_FAB_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/default_margin"
        android:clickable="true"
        android:text="@string/right"
        android:textAllCaps="true"
        app:icon="@drawable/arrow_right"
        android:textStyle="bold"

        app:iconTint="@color/white" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main_IMG_players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/margin_bottom_player"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_above="@id/main_FAB_right">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_player1"
            android:layout_width="@dimen/player_width"
            android:layout_height="@dimen/player_height"
            android:layout_weight="1"
            android:visibility="invisible"
            app:srcCompat="@drawable/spaceship" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_player2"
            android:layout_width="@dimen/player_width"
            android:layout_height="@dimen/player_height"
            android:layout_weight="1"
            android:visibility="visible"
            app:srcCompat="@drawable/spaceship" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_player3"
            android:layout_width="@dimen/player_width"
            android:layout_height="@dimen/player_height"
            android:layout_weight="1"
            android:visibility="invisible"
            app:srcCompat="@drawable/spaceship" />


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main_IMG_hearts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_heart0"
            android:layout_width="@dimen/heart_margins"
            android:layout_height="@dimen/heart_margins"
            android:layout_marginHorizontal="10dp"
            android:visibility="visible"
            app:srcCompat="@drawable/heart" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_heart1"
            android:layout_width="@dimen/heart_margins"
            android:layout_height="@dimen/heart_margins"
            android:layout_marginHorizontal="10dp"
            android:visibility="visible"
            app:srcCompat="@drawable/heart" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_heart2"
            android:layout_width="@dimen/heart_margins"
            android:layout_height="@dimen/heart_margins"
            android:layout_marginHorizontal="10dp"
            android:visibility="visible"
            app:srcCompat="@drawable/heart" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <GridLayout
        android:id="@+id/main_gridLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/main_IMG_hearts"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:columnCount="3"
        android:rowCount="5">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle1"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_margin="@dimen/default_margin_obstacle"
            android:visibility="invisible"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle2"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="0"
            android:layout_column="1"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle3"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_margin="@dimen/default_margin_obstacle"
            android:visibility="invisible"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle4"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="1"
            android:layout_column="0"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle5"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="1"
            android:layout_column="1"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle6"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="1"
            android:layout_column="2"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle7"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="2"
            android:layout_column="0"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle8"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="2"
            android:layout_column="1"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle9"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="2"
            android:layout_column="2"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle10"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_margin="@dimen/default_margin_obstacle"
            android:visibility="invisible"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle11"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="3"
            android:layout_column="1"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle12"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_margin="@dimen/default_margin_obstacle"
            android:visibility="invisible"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle13"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="4"
            android:layout_column="0"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle14"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="4"
            android:layout_column="1"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/main_IMG_obstacle15"
            android:layout_width="@dimen/obstacle_size"
            android:layout_height="@dimen/obstacle_size"
            android:layout_row="4"
            android:layout_column="2"
            android:visibility="invisible"
            android:layout_margin="@dimen/default_margin_obstacle"
            app:srcCompat="@drawable/obstacle" />
    </GridLayout>
    </RelativeLayout>
